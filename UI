        Size = UDim2.new(0, 0, 0, 0),
        ClipsDescendants = true,
        Parent = self.ScreenGui
    })
    Utilities:AddCorner(self.MainFrame)
    Utilities:AddStroke(self.MainFrame, self.Theme.Border)
    
    -- Animation d'ouverture
