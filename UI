            self:Toggle()
        end
    end)
    
    return self
end

function Window:SetTitle(title)
    self.Title = title
    self.TitleLabel.Text = title
end

function Window:Minimize()
    if not self.Minimized then
        self.Minimized = true
        Utilities:Tween(self.MainFrame, {
            Size = UDim2.new(0, self.Size.X.Offset, 0, 50)
        })
    end
end

function Window:Maximize()
    if self.Minimized then
        self.Minimized = false
        Utilities:Tween(self.MainFrame, {Size = self.Size})
    end
end

function Window:Toggle()
    if self.Minimized then
        self:Maximize()
    else
        self:Minimize()
    end
end

function Window:Destroy()
    Utilities:Tween(self.MainFrame, {
        Size = UDim2.new(0, 0, 0, 0)
    })
    
    if self.BlurEffect then
        Utilities:Tween(self.BlurEffect, {Size = 0})
        task.wait(Library.Settings.AnimationSpeed)
        self.BlurEffect:Destroy()
    end
    
    task.wait(Library.Settings.AnimationSpeed)
    self.ScreenGui:Destroy()
end

function Window:CreateTab(config)
    config = config or {}
    local Tab = setmetatable({}, {__index = {}})
    
    Tab.Name = config.Name or "Tab"
    Tab.Icon = config.Icon
    Tab.Window = self
    Tab.Active = false
    Tab.Sections = {}
    
    -- Bouton de l'onglet
    Tab.Button = Utilities:Create("TextButton", {
        Name = "TabButton",
        BackgroundColor3 = self.Theme.Secondary,
        Size = UDim2.new(1, 0, 0, 40),
        Font = Enum.Font.Gotham,
        Text = "  " .. Tab.Name,
        TextColor3 = self.Theme.TextDark,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = self.TabList
    })
    Utilities:AddCorner(Tab.Button)
    
    -- Icône si fournie
    if Tab.Icon then
        local icon = Utilities:Create("ImageLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 8, 0.5, -10),
            Size = UDim2.new(0, 20, 0, 20),
            Image = Tab.Icon,
            ImageColor3 = self.Theme.TextDark,
            Parent = Tab.Button
        })
        Tab.IconImage = icon
        Tab.Button.Text = "      " .. Tab.Name
    end
    
    -- Container du contenu de l'onglet
    Tab.Content = Utilities:Create("ScrollingFrame", {
        Name = "TabContent",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, -20, 1, -20),
        Position = UDim2.new(0, 10, 0, 10),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 4,
        BorderSizePixel = 0,
        ScrollBarImageColor3 = self.Theme.Accent,
        Visible = false,
        Parent = self.ContentContainer
    })
    
    Utilities:Create("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 10),
        Parent = Tab.Content
    })
    
    -- Fonction pour activer l'onglet
    function Tab:Activate()
        -- Désactiver tous les autres onglets
        for _, tab in pairs(self.Window.Tabs) do
            tab.Active = false
            tab.Content.Visible = false
            Utilities:Tween(tab.Button, {
                BackgroundColor3 = self.Window.Theme.Secondary
            })
            Utilities:Tween(tab.Button, {
                TextColor3 = self.Window.Theme.TextDark
            })
            if tab.IconImage then
                Utilities:Tween(tab.IconImage, {
                    ImageColor3 = self.Window.Theme.TextDark
                })
            end
        end
        
        -- Activer cet onglet
        self.Active = true
        self.Content.Visible = true
        self.Window.CurrentTab = self
        
        Utilities:Tween(self.Button, {
            BackgroundColor3 = self.Window.Theme.Accent
        })
        Utilities:Tween(self.Button, {
            TextColor3 = Color3.fromRGB(255, 255, 255)
        })
        if self.IconImage then
            Utilities:Tween(self.IconImage, {
                ImageColor3 = Color3.fromRGB(255, 255, 255)
            })
        end
    end
    
    Tab.Button.MouseButton1Click:Connect(function()
        Tab:Activate()
    end)
    
    -- Fonction pour créer une section
    function Tab:CreateSection(name)
        local Section = {}
        Section.Name = name or "Section"
        Section.Tab = self
        Section.Elements = {}
        
        -- Container de la section
        Section.Container = Utilities:Create("Frame", {
            Name = "Section",
            BackgroundColor3 = self.Window.Theme.Foreground,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Parent = self.Content
        })
        Utilities:AddCorner(Section.Container)
        Utilities:AddStroke(Section.Container, self.Window.Theme.Border)
        
        -- Titre de la section
        Section.Title = Utilities:Create("TextLabel", {
            Name = "SectionTitle",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -20, 0, 30),
            Position = UDim2.new(0, 10, 0, 5),
            Font = Enum.Font.GothamBold,
            Text = Section.Name,
            TextColor3 = self.Window.Theme.Text,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Section.Container
        })
        
        -- Container pour les éléments
        Section.ElementContainer = Utilities:Create("Frame", {
            Name = "Elements",
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 40),
            Size = UDim2.new(1, -20, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            Parent = Section.Container
        })
        
        Utilities:Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8),
            Parent = Section.ElementContainer
        })
        
        table.insert(self.Sections, Section)
        return Section
    end
    
    -- Mettre à jour la hauteur du canvas
    Tab.Content:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
        Tab.Content.CanvasSize = UDim2.new(0, 0, 0, Tab.Content.UIListLayout.AbsoluteContentSize.Y + 10)
    end)
    
    table.insert(self.Tabs, Tab)
    
    -- Activer le premier onglet automatiquement
    if #self.Tabs == 1 then
        Tab:Activate()
    end
    
    -- Mettre à jour la hauteur du canvas des onglets
    self.TabList.CanvasSize = UDim2.new(0, 0, 0, self.TabList.UIListLayout.AbsoluteContentSize.Y + 10)
    
    return Tab
end

-- Charger les composants
local Components = {}

-- COMPOSANT: Button
function Components:CreateButton(section, config)
    config = config or {}
    local Button = {}
    
    Button.Name = config.Name or "Button"
    Button.Description = config.Description or ""
    Button.Callback = config.Callback or function() end
    
    Button.Frame = Utilities:Create("Frame", {
        Name = "Button",
        BackgroundColor3 = section.Tab.Window.Theme.Secondary,
        Size = UDim2.new(1, 0, 0, config.Description ~= "" and 55 or 40),
        Parent = section.ElementContainer
    })
    Utilities:AddCorner(Button.Frame)
    
    Button.Button = Utilities:Create("TextButton", {
        Name = "ButtonClick",
        BackgroundColor3 = section.Tab.Window.Theme.Accent,
        Size = UDim2.new(1, -10, 0, config.Description ~= "" and 30 or 32),
        Position = UDim2.new(0, 5, 0, 5),
        Font = Enum.Font.GothamBold,
        Text = Button.Name,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 13,
        Parent = Button.Frame
    })
    Utilities:AddCorner(Button.Button)
    
    if Button.Description ~= "" then
        Button.DescLabel = Utilities:Create("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 10, 0, 38),
            Size = UDim2.new(1, -20, 0, 14),
            Font = Enum.Font.Gotham,
            Text = Button.Description,
            TextColor3 = section.Tab.Window.Theme.TextDark,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Button.Frame
        })
    end
    
    Utilities:AddHoverEffect(Button.Button, section.Tab.Window.Theme)
    
    Button.Button.MouseButton1Click:Connect(function()
        Utilities:Tween(Button.Button, {Size = UDim2.new(1, -12, 0, config.Description ~= "" and 28 or 30)}, 0.1)
        task.wait(0.1)
        Utilities:Tween(Button.Button, {Size = UDim2.new(1, -10, 0, config.Description ~= "" and 30 or 32)}, 0.1)
        pcall(Button.Callback)
    end)
    
    return Button
end

