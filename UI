                    Parent = HueBar
                })
                
                -- Curseur de teinte
                local HueCursor = U:New("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    Position = UDim2.new(0.5, 0, ColorPicker.Hue, 0),
                    Size = UDim2.new(1, 4, 0, 6),
                    ZIndex = 1002,
                    Parent = HueBar
                })
                U:Corner(HueCursor, 3)
                U:Stroke(HueCursor, Color3.fromRGB(0, 0, 0), 2, 0)
                
                -- RGB Values Display
                local RGBDisplay = U:New("Frame", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 250),
                    Size = UDim2.new(1, 0, 0, 30),
                    ZIndex = 1001,
                    Parent = ColorPicker.PickerMenu
                })
                
                local r, g, b = math.floor(ColorPicker.Value.R * 255), math.floor(ColorPicker.Value.G * 255), math.floor(ColorPicker.Value.B * 255)
                
                local RGBLabel = U:New("TextLabel", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.3,
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(0.5, -5, 1, 0),
                    Font = Library:GetFont(true),
                    Text = string.format("%d, %d, %d", r, g, b),
                    TextColor3 = Library.Theme.Text,
                    TextSize = 12,
                    ZIndex = 1002,
                    Parent = RGBDisplay
                })
                U:Corner(RGBLabel, 6)
                
                -- Hex Input
                local HexInput = U:New("TextBox", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.3,
                    Position = UDim2.new(0.5, 5, 0, 0),
                    Size = UDim2.new(0.5, -5, 1, 0),
                    Font = Library:GetFont(false),
                    PlaceholderText = "#FFFFFF",
                    Text = colorToHex(ColorPicker.Value),
                    TextColor3 = Library.Theme.TextSub,
                    TextSize = 12,
                    ZIndex = 1002,
                    Parent = RGBDisplay
                })
                U:Corner(HexInput, 6)
                
                -- Copy/Paste Buttons
                local ButtonsFrame = U:New("Frame", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 0, 0, 290),
                    Size = UDim2.new(1, 0, 0, 30),
                    ZIndex = 1001,
                    Parent = ColorPicker.PickerMenu
                })
                
                local CopyBtn = U:New("TextButton", {
                    BackgroundColor3 = Library.Theme.Success,
                    BackgroundTransparency = 0.2,
                    Position = UDim2.new(0, 0, 0, 0),
                    Size = UDim2.new(0.5, -5, 1, 0),
                    Font = Library:GetFont(true),
                    Text = "Copy",
                    TextColor3 = Library.Theme.Text,
                    TextSize = 12,
                    ZIndex = 1002,
                    Parent = ButtonsFrame
                })
                U:Corner(CopyBtn, 6)
                U:Ripple(CopyBtn)
                
                local PasteBtn = U:New("TextButton", {
                    BackgroundColor3 = Library.Theme.Warning,
                    BackgroundTransparency = 0.2,
                    Position = UDim2.new(0.5, 5, 0, 0),
                    Size = UDim2.new(0.5, -5, 1, 0),
                    Font = Library:GetFont(true),
                    Text = "Paste",
                    TextColor3 = Library.Theme.Text,
                    TextSize = 12,
                    ZIndex = 1002,
                    Parent = ButtonsFrame
                })
                U:Corner(PasteBtn, 6)
                U:Ripple(PasteBtn)
                
                -- Update color function
                function ColorPicker:UpdateColor()
                    self.Value = Color3.fromHSV(self.Hue, self.Sat, self.Val)
                    self.Display.BackgroundColor3 = self.Value
                    
                    -- Update RGB display
                    local r, g, b = math.floor(self.Value.R * 255), math.floor(self.Value.G * 255), math.floor(self.Value.B * 255)
                    RGBLabel.Text = string.format("%d, %d, %d", r, g, b)
                    HexInput.Text = colorToHex(self.Value)
                    
                    -- Update SV canvas color
                    SVCanvas.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
                    
                    self.Callback(self.Value)
                end
                
                -- SV Canvas dragging
                local draggingSV = false
                local draggingHue = false
                
                SVCanvas.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingSV = true
                    end
                end)
                
                HueBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingHue = true
                    end
                end)
                
                -- Un seul handler pour InputEnded
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingSV = false
                        draggingHue = false
                    end
                end)
                
                -- Un seul handler pour InputChanged
                UIS.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement then
                        if draggingSV then
                            local posX = math.clamp((input.Position.X - SVCanvas.AbsolutePosition.X) / SVCanvas.AbsoluteSize.X, 0, 1)
                            local posY = math.clamp((input.Position.Y - SVCanvas.AbsolutePosition.Y) / SVCanvas.AbsoluteSize.Y, 0, 1)
                            
                            ColorPicker.Sat = posX
                            ColorPicker.Val = 1 - posY
                            
                            SVCursor.Position = UDim2.new(posX, 0, posY, 0)
                            ColorPicker:UpdateColor()
                        elseif draggingHue then
                            local posY = math.clamp((input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                            
                            ColorPicker.Hue = posY
                            HueCursor.Position = UDim2.new(0.5, 0, posY, 0)
                            ColorPicker:UpdateColor()
                        end
                    end
                end)
                
                -- Hex Input
                HexInput.FocusLost:Connect(function()
                    local newColor = hexToColor(HexInput.Text)
                    if newColor then
                        ColorPicker.Value = newColor
                        ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Val = newColor:ToHSV()
                        SVCursor.Position = UDim2.new(ColorPicker.Sat, 0, 1 - ColorPicker.Val, 0)
                        HueCursor.Position = UDim2.new(0.5, 0, ColorPicker.Hue, 0)
                        ColorPicker:UpdateColor()
                    end
                end)
                
                -- Copy Button
                CopyBtn.MouseButton1Click:Connect(function()
                    _G.CopiedColor = ColorPicker.Value
                end)
                
                -- Paste Button
                PasteBtn.MouseButton1Click:Connect(function()
                    if _G.CopiedColor then
                        ColorPicker.Value = _G.CopiedColor
                        ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Val = _G.CopiedColor:ToHSV()
                        SVCursor.Position = UDim2.new(ColorPicker.Sat, 0, 1 - ColorPicker.Val, 0)
                        HueCursor.Position = UDim2.new(0.5, 0, ColorPicker.Hue, 0)
                        ColorPicker:UpdateColor()
                    end
                end)
                
                -- Left Click Display: Random Color
                ColorPicker.Display.MouseButton1Click:Connect(function()
                    local newColor = Color3.fromHSV(math.random(), 0.7 + math.random() * 0.3, 0.8 + math.random() * 0.2)
                    ColorPicker.Value = newColor
                    ColorPicker.Hue, ColorPicker.Sat, ColorPicker.Val = newColor:ToHSV()
                    SVCursor.Position = UDim2.new(ColorPicker.Sat, 0, 1 - ColorPicker.Val, 0)
                    HueCursor.Position = UDim2.new(0.5, 0, ColorPicker.Hue, 0)
                    ColorPicker:UpdateColor()
                end)
                
                -- Right Click Display: Open Picker
                ColorPicker.Display.MouseButton2Click:Connect(function()
                    Library:CloseAllMenus()
                    ColorPicker.PickerMenu.Visible = not ColorPicker.PickerMenu.Visible
                    if ColorPicker.PickerMenu.Visible then
                        local displayPos = ColorPicker.Display.AbsolutePosition
                        local displaySize = ColorPicker.Display.AbsoluteSize
                        ColorPicker.PickerMenu.Position = UDim2.new(0, displayPos.X, 0, displayPos.Y + displaySize.Y + 5)
                        
                        -- Animation d'ouverture smooth
                        ColorPicker.PickerMenu.Size = UDim2.new(0, 300, 0, 0)
                        U:Tween(ColorPicker.PickerMenu, { Size = UDim2.new(0, 300, 0, 340) }, 0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                        
                        table.insert(Library.OpenMenus.ColorPickers, ColorPicker)
                    end
                end)
                
                -- Fermer quand on clique en dehors
                UIS.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 and ColorPicker.PickerMenu.Visible then
                        local mouse = UIS:GetMouseLocation()
                        local menuPos = ColorPicker.PickerMenu.AbsolutePosition
                        local menuSize = ColorPicker.PickerMenu.AbsoluteSize
                        local displayPos = ColorPicker.Display.AbsolutePosition
                        local displaySize = ColorPicker.Display.AbsoluteSize
                        
                        -- Vérifier si le clic est en dehors du menu ET du display button
                        local outsideMenu = mouse.X < menuPos.X or mouse.X > menuPos.X + menuSize.X or
                                           mouse.Y < menuPos.Y or mouse.Y > menuPos.Y + menuSize.Y
                        local outsideDisplay = mouse.X < displayPos.X or mouse.X > displayPos.X + displaySize.X or
                                              mouse.Y < displayPos.Y or mouse.Y > displayPos.Y + displaySize.Y
                        
                        if outsideMenu and outsideDisplay then
                            -- Animation de fermeture smooth
                            U:Tween(ColorPicker.PickerMenu, { Size = UDim2.new(0, 300, 0, 0) }, 0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                            task.wait(0.2)
                            ColorPicker.PickerMenu.Visible = false
                        end
                    end
                end)
                
                U:Ripple(ColorPicker.Display)
                
                return ColorPicker
            end
            
            -- TEXTBOX
            function Section:CreateTextBox(config)
                config = config or {}
                
                local TextBox = {
                    Name = config.Name or "TextBox",
                    Default = config.Default or "",
                    PlaceholderText = config.PlaceholderText or "Enter text...",
                    Callback = config.Callback or function() end,
                    Value = config.Default or ""
                }
                
                TextBox.Frame = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.Panel,
                    BackgroundTransparency = 0.5,
                    Size = UDim2.new(1, 0, 0, 50),
                    ZIndex = 5,
                    Parent = self.ElementContainer
                })
                U:Corner(TextBox.Frame)
                
                TextBox.Label = U:New("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 5),
                    Size = UDim2.new(1, -24, 0, 18),
                    Font = Library:GetFont(false),
                    Text = TextBox.Name,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                    Parent = TextBox.Frame
                })
                
                TextBox.Input = U:New("TextBox", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.3,
                    Position = UDim2.new(0, 12, 0, 26),
                    Size = UDim2.new(1, -24, 0, 30),
                    Font = Library:GetFont(false),
                    PlaceholderText = TextBox.PlaceholderText,
                    PlaceholderColor3 = Library.Theme.TextDim,
                    Text = TextBox.Value,
                    TextColor3 = Library.Theme.TextSub,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ClearTextOnFocus = false,
                    ZIndex = 6,
                    Parent = TextBox.Frame
                })
                U:Corner(TextBox.Input, 8)
                U:Stroke(TextBox.Input, Library.Theme.Border, 1, 0.6)
                
                U:New("UIPadding", {
                    PaddingLeft = UDim.new(0, 10),
                    PaddingRight = UDim.new(0, 10),
                    Parent = TextBox.Input
                })
                
                TextBox.Input.FocusLost:Connect(function()
                    TextBox.Value = TextBox.Input.Text
                    TextBox.Callback(TextBox.Value)
                end)
                
                return TextBox
            end
            
            -- KEYBIND
            function Section:CreateKeybind(config)
                config = config or {}
                
                local Keybind = {
                    Name = config.Name or "Keybind",
                    Default = config.Default or "None",
                    Callback = config.Callback or function() end,
                    Value = config.Default or "None",
                    Listening = false
                }
                
                Keybind.Frame = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.Panel,
                    BackgroundTransparency = 0.5,
                    Size = UDim2.new(1, 0, 0, 40),
                    ZIndex = 5,
                    Parent = self.ElementContainer
                })
                U:Corner(Keybind.Frame)
                
                Keybind.Label = U:New("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 0),
                    Size = UDim2.new(1, -90, 1, 0),
                    Font = Library:GetFont(false),
                    Text = Keybind.Name,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                    Parent = Keybind.Frame
                })
                
                Keybind.Button = U:New("TextButton", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.3,
                    Position = UDim2.new(1, -75, 0.5, -14),
                    Size = UDim2.new(0, 65, 0, 28),
                    Font = Library:GetFont(true),
                    Text = Keybind.Value,
                    TextColor3 = Library.Theme.Primary,
                    TextSize = 12,
                    ZIndex = 6,
                    Parent = Keybind.Frame
                })
                U:Corner(Keybind.Button, 8)
                
                Keybind.Button.MouseButton1Click:Connect(function()
                    Keybind.Listening = true
                    Keybind.Button.Text = "..."
                end)
                
                UIS.InputBegan:Connect(function(input, gameProcessed)
                    if Keybind.Listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        local key = input.KeyCode.Name
                        Keybind.Value = key
                        Keybind.Button.Text = key
                        Keybind.Listening = false
                    end
                    
                    if not gameProcessed and input.KeyCode.Name == Keybind.Value and not Keybind.Listening then
                        Keybind.Callback()
                    end
                end)
                
                U:Ripple(Keybind.Button)
                
                return Keybind
            end
            
            -- LABEL
            function Section:CreateLabel(config)
                config = config or {}
                
                local Label = {
                    Text = config.Text or "Label"
                }
                
                Label.Frame = U:New("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 24),
                    Font = Library:GetFont(false),
                    Text = Label.Text,
                    TextColor3 = Library.Theme.TextSub,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    ZIndex = 5,
                    Parent = self.ElementContainer
                })
                
                function Label:Set(text)
                    self.Text = text
                    self.Frame.Text = text
                end
                
                return Label
            end
            
            table.insert(self.Sections, Section)
            return Section
        end
        
        -- Update canvas size based on columns height
        for _, column in ipairs(Tab.Columns) do
            column:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                local maxHeight = 0
                for _, col in ipairs(Tab.Columns) do
                    if col.AbsoluteSize.Y > maxHeight then
                        maxHeight = col.AbsoluteSize.Y
                    end
                end
                Tab.Content.CanvasSize = UDim2.new(0, 0, 0, maxHeight + 20)
            end)
        end
        
        table.insert(self.Tabs, Tab)
        
        -- Auto activate first tab
        if #self.Tabs == 1 then
            Tab:Activate()
        -- Si c'est le Home tab, l'activer même s'il y a déjà des tabs
        elseif Tab.Name == "🏠 Home" then
            Tab:Activate()
        end
        
        self.TabList.CanvasSize = UDim2.new(0, 0, 0, self.TabList.UIListLayout.AbsoluteContentSize.Y + 10)
        
        return Tab
    end
    
    function Window:Toggle()
        self.Visible = not self.Visible
        if not self.Visible then
            -- Cacher complètement l'UI
            self.GUI.Enabled = false
            U:Tween(self.Blur, { Size = 0 }, 0.3)
        else
            -- Réafficher l'UI
            self.GUI.Enabled = true
            U:Tween(self.Blur, { Size = Library.Config.BlurIntensity }, 0.3)
        end
    end
    
    function Window:Destroy()
        U:Tween(self.Main, { Size = UDim2.new(0, 0, 0, 0) }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        U:Tween(self.Blur, { Size = 0 }, 0.3)
        task.wait(0.4)
        self.GUI:Destroy()
        self.Blur:Destroy()
    end
    
    return Window
end

return Library
