                })
                
                Dropdown.List = U:New("ScrollingFrame", {
                    BackgroundColor3 = Library.Theme.Panel,
                    BackgroundTransparency = 0.05,
                    Size = UDim2.new(0, 0, 0, 0),
                    CanvasSize = UDim2.new(0, 0, 0, 0),
                    ScrollBarThickness = 4,
                    ScrollBarImageColor3 = Library.Theme.Primary,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 1000,
                    Parent = Dropdown.MenuGui
                })
                U:Corner(Dropdown.List, 8)
                U:Stroke(Dropdown.List, Library.Theme.Primary, 2, 0.7)
                
                local listLayout = U:New("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Padding = UDim.new(0, 3),
                    Parent = Dropdown.List
                })
                
                U:New("UIPadding", {
                    PaddingLeft = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8),
                    PaddingTop = UDim.new(0, 8),
                    PaddingBottom = UDim.new(0, 8),
                    Parent = Dropdown.List
                })
                
                function Dropdown:Set(value)
                    self.Value = value
                    self.Button.Text = "  " .. value .. "  ▼"
                    self.Callback(value)
                end
                
                function Dropdown:Toggle()
                    self.Open = not self.Open
                    Dropdown.List.Visible = self.Open
                    
                    if self.Open then
                        -- Fermer tous les autres menus avant d'ouvrir
                        Library:CloseAllMenus()
                        
                        -- Calculer position absolue du bouton
                        local btnPos = Dropdown.Button.AbsolutePosition
                        local btnSize = Dropdown.Button.AbsoluteSize
                        
                        local maxHeight = math.min(#self.Options * 33 + 16, 180)
                        local width = btnSize.X
                        
                        Dropdown.List.Position = UDim2.new(0, btnPos.X, 0, btnPos.Y + btnSize.Y + 2)
                        Dropdown.List.Size = UDim2.new(0, width, 0, 0)
                        Dropdown.List.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 16)
                        
                        -- Animation d'apparition smooth
                        U:Tween(Dropdown.List, {
                            Size = UDim2.new(0, width, 0, maxHeight)
                        }, Library.Config.AnimSpeed * 1.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                        
                        -- S'enregistrer
                        table.insert(Library.OpenMenus.Dropdowns, self)
                    else
                        U:Tween(Dropdown.List, {
                            Size = UDim2.new(0, Dropdown.List.AbsoluteSize.X, 0, 0)
                        }, Library.Config.AnimSpeed, Enum.EasingStyle.Back, Enum.EasingDirection.In)
                        
                        -- Se désenregistrer
                        for i, dd in ipairs(Library.OpenMenus.Dropdowns) do
                            if dd == self then
                                table.remove(Library.OpenMenus.Dropdowns, i)
                                break
                            end
                        end
                    end
                end
                
                -- Close dropdown when clicking outside
                local function closeOnOutsideClick(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        if Dropdown.Open then
                            local mousePos = UIS:GetMouseLocation()
                            local buttonPos = Dropdown.Button.AbsolutePosition
                            local buttonSize = Dropdown.Button.AbsoluteSize
                            local listPos = Dropdown.List.AbsolutePosition
                            local listSize = Dropdown.List.AbsoluteSize
                            
                            local inButton = mousePos.X >= buttonPos.X and mousePos.X <= buttonPos.X + buttonSize.X and
                                           mousePos.Y >= buttonPos.Y and mousePos.Y <= buttonPos.Y + buttonSize.Y
                            
                            local inList = mousePos.X >= listPos.X and mousePos.X <= listPos.X + listSize.X and
                                         mousePos.Y >= listPos.Y and mousePos.Y <= listPos.Y + listSize.Y
                            
                            if not inButton and not inList then
                                Dropdown:Toggle()
                            end
                        end
                    end
                end
                
                UIS.InputBegan:Connect(closeOnOutsideClick)
                
                Dropdown.Button.MouseButton1Click:Connect(function()
                    Dropdown:Toggle()
                end)
                
                for i, option in ipairs(Dropdown.Options) do
                    local optBtn = U:New("TextButton", {
                        BackgroundColor3 = Library.Theme.FG,
                        BackgroundTransparency = 0.4,
                        Size = UDim2.new(1, 0, 0, 30),
                        Font = Library:GetFont(false),
                        Text = option,
                        TextColor3 = Library.Theme.TextSub,
                        TextSize = 13,
                        LayoutOrder = i,
                        ZIndex = 1001,
                        Parent = Dropdown.List
                    })
                    U:Corner(optBtn, 6)
                    U:Ripple(optBtn)
                    U:Hover(optBtn)
                    
                    optBtn.MouseButton1Click:Connect(function()
                        Dropdown:Set(option)
                        Dropdown:Toggle()
                    end)
                end
                
                -- Update canvas size
                listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    Dropdown.List.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 16)
                end)
                
                return Dropdown
            end
            
