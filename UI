-- Utilities
local U = {}

function U:New(class, props)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        if k ~= "Parent" then
            pcall(function() obj[k] = v end)
        end
    end
    if props.Parent then obj.Parent = props.Parent end
    return obj
end

function U:Tween(obj, props, time, style, dir)
    local tween = TS:Create(obj, TweenInfo.new(
        time or Library.Config.AnimSpeed,
        style or Enum.EasingStyle.Quint,
        dir or Enum.EasingDirection.Out
    ), props)
    tween:Play()
    return tween
end

function U:Corner(parent, r)
    return U:New("UICorner", {
        CornerRadius = UDim.new(0, r or Library.Config.CornerRadius),
        Parent = parent
    })
end

function U:Stroke(parent, color, thick, alpha)
    return U:New("UIStroke", {
        Color = color,
        Thickness = thick or 1,
        Transparency = alpha or 0.6,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent
    })
end

function U:Gradient(parent, c1, c2, rotation)
    return U:New("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rotation or 45,
        Parent = parent
    })
end

function U:Glow(parent, color)
    if not Library.Config.GlowEnabled then return end
    
    local glow = U:New("ImageLabel", {
        Name = "Glow",
        BackgroundTransparency = 1,
