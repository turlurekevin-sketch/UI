    end
    
    function Window:Toggle()
        self.Minimized = not self.Minimized
        if self.Minimized then
            U:Tween(self.Main, { Size = UDim2.new(0, self.Size.X.Offset, 0, 55) }, 0.3)
        else
            U:Tween(self.Main, { Size = self.Size }, 0.3)
        end
    end
    
    function Window:Destroy()
        U:Tween(self.Main, { Size = UDim2.new(0, 0, 0, 0) }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.In)
        U:Tween(self.Blur, { Size = 0 }, 0.3)
        task.wait(0.4)
        self.GUI:Destroy()
        self.Blur:Destroy()
    end
    
    return Window
end

return Library
