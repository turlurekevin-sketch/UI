                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                
                Slider.Track = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.3,
                    Position = UDim2.new(0, 12, 1, -18),
                    Size = UDim2.new(1, -24, 0, 6),
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                U:Corner(Slider.Track, 3)
                
                Slider.Fill = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.Primary,
                    Size = UDim2.new((Slider.Value - Slider.Min) / (Slider.Max - Slider.Min), 0, 1, 0),
                    ZIndex = 7,
                    Parent = Slider.Track
                })
                U:Corner(Slider.Fill, 3)
                U:Gradient(Slider.Fill, Library.Theme.Primary, Library.Theme.Secondary)
                
                local dragging = false
                
                function Slider:Set(value)
                    value = math.clamp(value, self.Min, self.Max)
                    value = math.floor(value / self.Increment + 0.5) * self.Increment
                    self.Value = value
                    
                    self.ValueLabel.Text = tostring(value)
                    U:Tween(self.Fill, {
                        Size = UDim2.new((value - self.Min) / (self.Max - self.Min), 0, 1, 0)
                    }, 0.15)
                    
                    self.Callback(value)
                end
                
                Slider.Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                    end
                end)
                
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local pos = (input.Position.X - Slider.Track.AbsolutePosition.X) / Slider.Track.AbsoluteSize.X
                        pos = math.clamp(pos, 0, 1)
                        local value = Slider.Min + (Slider.Max - Slider.Min) * pos
                        Slider:Set(value)
                    end
                end)
                
                return Slider
            end
            
