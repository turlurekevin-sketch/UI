-- Fonction pour fermer tous les menus
function Library:CloseAllMenus()
    -- Fermer tous les dropdowns
    for _, dropdown in pairs(self.OpenMenus.Dropdowns) do
        if dropdown and dropdown.Open then
            dropdown:Toggle()
        end
    end
    
    -- Fermer tous les color pickers
    for _, picker in pairs(self.OpenMenus.ColorPickers) do
        if picker and picker.PickerMenu and picker.PickerMenu.Visible then
            picker.PickerMenu.Visible = false
        end
    end
end

