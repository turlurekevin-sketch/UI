    Utilities:AddCorner(Slider.SliderFill, 4)
    
    Slider.SliderCircle = Utilities:Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Position = UDim2.new(percentage, -6, 0.5, -6),
        Size = UDim2.new(0, 12, 0, 12),
        Parent = Slider.SliderBack
    })
    Utilities:AddCorner(Slider.SliderCircle, 6)
    Utilities:AddStroke(Slider.SliderCircle, self.Tab.Window.Theme.Accent, 2)
    
    function Slider:SetValue(value)
        value = math.clamp(value, self.Min, self.Max)
        value = math.floor(value / self.Increment + 0.5) * self.Increment
        self.Value = value
        
        local percentage = (value - self.Min) / (self.Max - self.Min)
        
        Utilities:Tween(self.SliderFill, {Size = UDim2.new(percentage, 0, 1, 0)}, 0.15)
        Utilities:Tween(self.SliderCircle, {Position = UDim2.new(percentage, -6, 0.5, -6)}, 0.15)
        
        self.ValueLabel.Text = tostring(value)
        pcall(self.Callback, value)
    end
    
    local dragging = false
    
    Slider.SliderBack.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local percentage = math.clamp((input.Position.X - Slider.SliderBack.AbsolutePosition.X) / Slider.SliderBack.AbsoluteSize.X, 0, 1)
            local value = Slider.Min + (Slider.Max - Slider.Min) * percentage
            Slider:SetValue(value)
        end
    end)
    
    Slider.SliderBack.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local percentage = math.clamp((input.Position.X - Slider.SliderBack.AbsolutePosition.X) / Slider.SliderBack.AbsoluteSize.X, 0, 1)
            local value = Slider.Min + (Slider.Max - Slider.Min) * percentage
            Slider:SetValue(value)
        end
    end)
    
    return Slider
end

