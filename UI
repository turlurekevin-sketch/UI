-- Helper function to update all corner radius
function Library:UpdateCornerRadius()
    for _, desc in ipairs(CoreGui:GetDescendants()) do
        if desc:IsA("UICorner") and desc.Parent and desc.Parent:IsDescendantOf(CoreGui) then
            -- Ne pas toucher aux corners circulaires (handles, avatars)
            if desc.CornerRadius.Offset < 50 then
                desc.CornerRadius = UDim.new(0, self.Config.CornerRadius)
            end
        end
    end
end

-- Helper function to get font
function Library:GetFont(bold)
    if bold and self.Config.FontBold then
        return self.Fonts[self.Config.FontBold] or Enum.Font.GothamBold
    else
        return self.Fonts[self.Config.Font] or Enum.Font.Gotham
    end
end

