            Utilities:Tween(self.Arrow, {Rotation = 0}, 0.2)
            task.wait(Library.Settings.AnimationSpeed)
            self.DropList.Visible = false
        end
    end
    
    function Dropdown:SetValue(value)
        self.Value = value
        self.Button.Text = "  " .. value
        pcall(self.Callback, value)
    end
    
    Dropdown.Button.MouseButton1Click:Connect(function()
        Dropdown:Toggle()
    end)
    
    Dropdown.Tab = {Window = {Theme = self.Tab.Window.Theme}}
    Dropdown:SetOptions(Dropdown.Options)
    
    return Dropdown
end

