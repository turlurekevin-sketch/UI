                    Min = config.Min or 0,
                    Max = config.Max or 100,
                    Default = config.Default or 50,
                    Increment = config.Increment or 1,
                    Callback = config.Callback or function() end,
                    Value = config.Default or 50
                }
                
                Slider.Frame = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.Panel,
                    BackgroundTransparency = 0.5,
                    Size = UDim2.new(1, 0, 0, 65),
                    ZIndex = 5,
                    Parent = self.ElementContainer
                })
                U:Corner(Slider.Frame)
                
                Slider.Label = U:New("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 0, 8),
                    Size = UDim2.new(1, -90, 0, 18),
                    Font = Library:GetFont(false),
                    Text = Slider.Name,
                    TextColor3 = Library.Theme.Text,
                    TextSize = 14,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                
                -- Input box pour entrer valeur manuellement
                Slider.ValueInput = U:New("TextBox", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.2,
                    Position = UDim2.new(1, -70, 0, 6),
                    Size = UDim2.new(0, 60, 0, 22),
                    Font = Library:GetFont(true),
                    Text = tostring(Slider.Value),
                    TextColor3 = Library.Theme.Primary,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    ClearTextOnFocus = false,
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                U:Corner(Slider.ValueInput, 6)
                U:Stroke(Slider.ValueInput, Library.Theme.Primary, 1, 0.5)
                
                Slider.ValueInput.FocusLost:Connect(function()
                    local value = tonumber(Slider.ValueInput.Text)
                    if value then
                        Slider:Set(value)
                    else
                        Slider.ValueInput.Text = tostring(Slider.Value)
                    end
                end)
                
                -- Track (barre de fond)
                Slider.Track = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.FG,
                    BackgroundTransparency = 0.4,
                    Position = UDim2.new(0, 12, 0, 38),
                    Size = UDim2.new(1, -24, 0, 8),
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                U:Corner(Slider.Track, 4)
                
                -- Fill (barre de progression avec gradient)
                Slider.Fill = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.Primary,
                    Size = UDim2.new((Slider.Value - Slider.Min) / (Slider.Max - Slider.Min), 0, 1, 0),
                    ZIndex = 7,
                    Parent = Slider.Track
                })
                U:Corner(Slider.Fill, 4)
                U:Gradient(Slider.Fill, Library.Theme.Primary, Library.Theme.Secondary)
                
                -- Handle (poignée ronde)
                local handlePos = (Slider.Value - Slider.Min) / (Slider.Max - Slider.Min)
                Slider.Handle = U:New("Frame", {
                    BackgroundColor3 = Library.Theme.Primary,
                    BackgroundTransparency = 0,
                    Position = UDim2.new(handlePos, -8, 0.5, -8),
                    Size = UDim2.new(0, 16, 0, 16),
                    AnchorPoint = Vector2.new(0, 0.5),
                    ZIndex = 8,
                    Parent = Slider.Track
                })
                U:Corner(Slider.Handle, 8)
                U:Glow(Slider.Handle, Library.Theme.Primary)
                
                -- Inner glow sur le handle
                local handleInner = U:New("Frame", {
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BackgroundTransparency = 0.5,
                    Position = UDim2.new(0.5, 0, 0.5, 0),
                    Size = UDim2.new(0, 8, 0, 8),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    ZIndex = 9,
                    Parent = Slider.Handle
                })
                U:Corner(handleInner, 4)
                
                local dragging = false
                local hovering = false
                
                function Slider:Set(value)
                    value = math.clamp(value, self.Min, self.Max)
                    value = math.floor(value / self.Increment + 0.5) * self.Increment
                    
                    -- Arrondir pour éviter les décimales infinies
                    if self.Increment >= 1 then
                        value = math.floor(value)
                    else
                        -- Limiter à 2 décimales max
                        value = math.floor(value * 100 + 0.5) / 100
                    end
                    
                    self.Value = value
                    
                    local pos = (value - self.Min) / (self.Max - self.Min)
                    
                    self.ValueInput.Text = tostring(value)
                    
                    U:Tween(self.Fill, {
                        Size = UDim2.new(pos, 0, 1, 0)
                    }, 0.15, Enum.EasingStyle.Quint)
                    
                    U:Tween(self.Handle, {
                        Position = UDim2.new(pos, -8, 0.5, -8)
                    }, 0.15, Enum.EasingStyle.Quint)
                    
                    self.Callback(value)
                end
                
                -- Hover effect sur handle
                Slider.Handle.MouseEnter:Connect(function()
                    hovering = true
                    U:Tween(Slider.Handle, {
                        Size = UDim2.new(0, 20, 0, 20)
                    }, 0.2, Enum.EasingStyle.Quad)
                end)
                
                Slider.Handle.MouseLeave:Connect(function()
                    if not dragging then
                        hovering = false
                        U:Tween(Slider.Handle, {
                            Size = UDim2.new(0, 16, 0, 16)
                        }, 0.2, Enum.EasingStyle.Quad)
                    end
                end)
                
                -- Dragging
                Slider.Track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        U:Tween(Slider.Handle, {
                            Size = UDim2.new(0, 22, 0, 22)
                        }, 0.1, Enum.EasingStyle.Quad)
                    end
                end)
                
                Slider.Handle.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        U:Tween(Slider.Handle, {
                            Size = UDim2.new(0, 22, 0, 22)
                        }, 0.1, Enum.EasingStyle.Quad)
                    end
                end)
                
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                        if not hovering then
                            U:Tween(Slider.Handle, {
                                Size = UDim2.new(0, 16, 0, 16)
                            }, 0.2, Enum.EasingStyle.Quad)
                        else
                            U:Tween(Slider.Handle, {
                                Size = UDim2.new(0, 20, 0, 20)
                            }, 0.2, Enum.EasingStyle.Quad)
                        end
                    end
                end)
                
                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        local pos = (input.Position.X - Slider.Track.AbsolutePosition.X) / Slider.Track.AbsoluteSize.X
                        pos = math.clamp(pos, 0, 1)
                        local value = Slider.Min + (Slider.Max - Slider.Min) * pos
                        Slider:Set(value)
                    end
                end)
                
                -- Min/Max labels
                local minLabel = U:New("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(0, 12, 1, -16),
                    Size = UDim2.new(0, 30, 0, 12),
                    Font = Library:GetFont(false),
                    Text = tostring(Slider.Min),
                    TextColor3 = Library.Theme.TextDim,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                
                local maxLabel = U:New("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -42, 1, -16),
                    Size = UDim2.new(0, 30, 0, 12),
                    Font = Library:GetFont(false),
                    Text = tostring(Slider.Max),
                    TextColor3 = Library.Theme.TextDim,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 6,
                    Parent = Slider.Frame
                })
                
                return Slider
            end
            
