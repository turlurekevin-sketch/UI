-- Appliquer les méthodes aux sections dans CreateSection
local OriginalCreateSection = Window.CreateTab
if OriginalCreateSection then
    function Window.CreateTab(self, config)
        local tab = OriginalCreateSection(self, config)
        
        local originalCreateSection = tab.CreateSection
        function tab:CreateSection(name)
            local section = originalCreateSection(self, name)
            
            for methodName, method in pairs(SectionMeta) do
                section[methodName] = method
            end
            
            return section
        end
        
        return tab
    end
end

