function Library:CreateWindow(config)
    config = config or {}
    local self = setmetatable({}, Window)
    
    -- Configuration
    self.Title = config.Title or "UI Library"
    self.Subtitle = config.Subtitle or ""
    self.Size = config.Size or Library.Settings.DefaultSize
    self.Theme = Library.Themes[config.Theme or "Dark"] or config.CustomTheme or Library.Themes.Dark
    self.Acrylic = config.Acrylic ~= false
    self.MinimizeKey = config.MinimizeKey or Enum.KeyCode.LeftControl
    
    self.Tabs = {}
    self.CurrentTab = nil
    self.Minimized = false
    
    -- Créer le ScreenGui
    self.ScreenGui = Utilities:Create("ScreenGui", {
        Name = "UILibrary_" .. math.random(1000, 9999),
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        Parent = RunService:IsStudio() and Player.PlayerGui or CoreGui
    })
    
    -- Effet de flou si activé
    if self.Acrylic then
        self.BlurEffect = Utilities:Create("BlurEffect", {
            Size = 0,
            Parent = game.Lighting
        })
        Utilities:Tween(self.BlurEffect, {Size = Library.Settings.BlurIntensity})
