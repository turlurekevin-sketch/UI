    -- Tab methods
    function Window:CreateTab(tabConfig)
        local Tab = {
            Name = tabConfig.Name or "Tab",
            Window = self,
            Active = false,
            Sections = {}
        }
        
        -- Tab button
        Tab.Button = U:New("TextButton", {
            BackgroundColor3 = Library.Theme.Panel,
            BackgroundTransparency = 0.7,
            Size = UDim2.new(1, 0, 0, 38),
            Font = Enum.Font.GothamMedium,
            Text = "  " .. Tab.Name,
            TextColor3 = Library.Theme.TextDim,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
            Parent = self.TabList
        })
        U:Corner(Tab.Button, 10)
        
        -- Tab content avec 3 colonnes
        Tab.Content = U:New("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -20, 1, -20),
            Position = UDim2.new(0, 10, 0, 10),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Library.Theme.Primary,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 3,
            Parent = self.ContentContainer
        })
        
        -- Container pour les 3 colonnes
        Tab.ColumnsContainer = U:New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            ZIndex = 3,
            Parent = Tab.Content
        })
        
        -- Créer 3 colonnes
        Tab.Columns = {}
        for i = 1, 3 do
            local column = U:New("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new((i-1) / 3, (i-1) * 5, 0, 0),
                Size = UDim2.new(1/3, -10, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 3,
                Parent = Tab.ColumnsContainer
            })
            
            U:New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 12),
                Parent = column
            })
            
            table.insert(Tab.Columns, column)
        end
        
        Tab.CurrentColumn = 1  -- Pour alterner entre les colonnes
        
        -- Activate tab
        function Tab:Activate()
            -- Fermer tous les menus ouverts
            Library:CloseAllMenus()
            
            for _, tab in pairs(self.Window.Tabs) do
                if tab.Active then
                    -- Animation de sortie pour l'ancien tab
                    U:Tween(tab.Content, { 
                        Position = UDim2.new(0, -20, 0, 10),
                        BackgroundTransparency = 1 
                    }, Library.Config.AnimSpeed)
                    task.wait(Library.Config.AnimSpeed)
                    tab.Content.Visible = false
                    tab.Content.Position = UDim2.new(0, 10, 0, 10)
                end
                
                tab.Active = false
                U:Tween(tab.Button, {
                    BackgroundTransparency = 0.7,
                    TextColor3 = Library.Theme.TextDim
                }, Library.Config.AnimSpeed)
            end
            
            self.Active = true
            self.Content.Visible = true
            self.Window.CurrentTab = self
            
            -- Animation d'entrée pour le nouveau tab
            self.Content.Position = UDim2.new(0, 30, 0, 10)
            U:Tween(self.Content, { 
                Position = UDim2.new(0, 10, 0, 10)
            }, Library.Config.AnimSpeed, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
            
            U:Tween(self.Button, {
                BackgroundTransparency = 0.2,
                TextColor3 = Library.Theme.Text
            }, Library.Config.AnimSpeed)
            
            -- Animation fade in pour les sections (pas les colonnes)
            for _, section in ipairs(self.Sections) do
                if section.Container then
                    section.Container.BackgroundTransparency = 1
                    U:Tween(section.Container, { 
                        BackgroundTransparency = 1 - Library.Theme.PanelAlpha 
                    }, Library.Config.AnimSpeed * 1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
                end
            end
        end
        
        Tab.Button.MouseButton1Click:Connect(function()
            Library:PlaySound("Click")
            Tab:Activate()
        end)
        
        -- Hover sound
        Tab.Button.MouseEnter:Connect(function()
            Library:PlaySound("Hover")
        end)
        
        U:Ripple(Tab.Button)
        U:Hover(Tab.Button)
        
        -- Section methods
        function Tab:CreateSection(name)
            local Section = {
                Name = name or "Section",
                Tab = self,
                Elements = {}
            }
            
            -- Vérifier que les colonnes existent
            if not self.Columns or #self.Columns == 0 then
                error("Erreur: Les colonnes du tab n'existent pas ! Tab: " .. tostring(self.Name))
                return
            end
            
            -- Choisir la colonne (alterner entre 1, 2, 3)
            local targetColumn = self.Columns[self.CurrentColumn]
            if not targetColumn then
                error("Erreur: Colonne " .. tostring(self.CurrentColumn) .. " introuvable !")
                return
            end
            self.CurrentColumn = (self.CurrentColumn % 3) + 1
            
            Section.Container = U:New("Frame", {
                BackgroundColor3 = Library.Theme.Panel,
                BackgroundTransparency = 1,  -- Commence invisible
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 3,
                Parent = targetColumn
            })
            U:Corner(Section.Container)
            U:Stroke(Section.Container, Library.Theme.Border, 1, Library.Theme.BorderAlpha)
            
            -- Animation d'apparition smooth
            task.spawn(function()
                task.wait(0.05)
                U:Tween(Section.Container, { 
                    BackgroundTransparency = 1 - Library.Theme.PanelAlpha 
                }, Library.Config.AnimSpeed, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
            end)
            
            Section.Title = U:New("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -20, 0, 28),
                Position = UDim2.new(0, 10, 0, 10),
                Font = Library.Config.FontBold,
                Text = Section.Name,
                TextColor3 = Library.Theme.Text,
                TextSize = 15,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                ZIndex = 4,
                Parent = Section.Container
            })
            
            -- Make section draggable
            if Library.Config.DraggableSections then
                U:MakeSectionDraggable(Section.Container, Section.Title)
            end
            
            Section.ElementContainer = U:New("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 10, 0, 48),
                Size = UDim2.new(1, -20, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 4,
                Parent = Section.Container
            })
            
            U:New("UIListLayout", {
                SortOrder = Enum.SortOrder.LayoutOrder,
                Padding = UDim.new(0, 10),
                Parent = Section.ElementContainer
            })
            
            -- Padding pour donner de l'espace en bas
            U:New("UIPadding", {
                PaddingBottom = UDim.new(0, 10),
                Parent = Section.ElementContainer
            })
            
            -- BUTTON
            function Section:CreateButton(config)
                config = config or {}
                
                local Button = {
                    Name = config.Name or "Button",
                    Callback = config.Callback or function() end
                }
                
                Button.Frame = U:New("TextButton", {
                    BackgroundColor3 = Library.Theme.Primary,
