function U:Ripple(button)
    if not Library.Config.RippleEnabled then return end
    
    button.MouseButton1Down:Connect(function()
        local ripple = U:New("Frame", {
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BackgroundTransparency = 0.4,
            Size = UDim2.new(0, 0, 0, 0),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = (button.ZIndex or 1) + 10,
            Parent = button
        })
        U:Corner(ripple, 999)
        
        U:Tween(ripple, {
            Size = UDim2.new(1, 60, 1, 60),
            BackgroundTransparency = 1
        }, 0.5, Enum.EasingStyle.Quart)
        
        task.delay(0.5, function()
            if ripple and ripple.Parent then
                ripple:Destroy()
            end
        end)
    end)
end

function U:Hover(button, normalColor, hoverColor)
    local norm = normalColor or button.BackgroundColor3
    local hov = hoverColor or Library.Theme.Hover
    
    button.MouseEnter:Connect(function()
        U:Tween(button, { BackgroundColor3 = hov }, 0.2, Enum.EasingStyle.Quad)
    end)
    
    button.MouseLeave:Connect(function()
        U:Tween(button, { BackgroundColor3 = norm }, 0.2, Enum.EasingStyle.Quad)
    end)
end

function U:Drag(frame, handle)
    local dragging, dragInput, startPos, inputStart
    
    handle = handle or frame
    
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            inputStart = input.Position
            startPos = frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)
    
    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - inputStart
            U:Tween(frame, {
                Position = UDim2.new(
                    startPos.X.Scale,
                    startPos.X.Offset + delta.X,
                    startPos.Y.Scale,
                    startPos.Y.Offset + delta.Y
                )
            }, 0.1, Enum.EasingStyle.Sine)
        end
    end)
end

function U:Particles(parent)
    if not Library.Config.ParticlesEnabled then return end
    
    task.spawn(function()
        while parent and parent.Parent and wait(math.random(20, 40) / 10) do
            local p = U:New("Frame", {
                BackgroundColor3 = Library.Theme.Primary,
                BackgroundTransparency = 0.6,
                Size = UDim2.new(0, math.random(2, 5), 0, math.random(2, 5)),
                Position = UDim2.new(math.random(0, 100) / 100, 0, 1, 0),
                ZIndex = (parent.ZIndex or 1) + 20,
                Parent = parent
            })
            U:Corner(p, 999)
            
            local dur = math.random(40, 70) / 10
            U:Tween(p, {
                Position = UDim2.new(
                    p.Position.X.Scale + (math.random(-15, 15) / 100),
                    0, -0.1, 0
                ),
                BackgroundTransparency = 1
            }, dur, Enum.EasingStyle.Linear)
            
            task.delay(dur, function()
                if p and p.Parent then p:Destroy() end
            end)
        end
    end)
end

-- Cursor Trail Effect
function U:CursorTrail(gui)
    local trail = {}
    local maxTrail = 15
    
    for i = 1, maxTrail do
        local dot = U:New("Frame", {
            BackgroundColor3 = Library.Theme.Primary,
            BackgroundTransparency = 0.3 + (i / maxTrail) * 0.7,
            Size = UDim2.new(0, 8 - (i / 3), 0, 8 - (i / 3)),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = 1000,
            Parent = gui
        })
        U:Corner(dot, 999)
        table.insert(trail, dot)
    end
    
    local conn = RS.RenderStepped:Connect(function()
        if Library.Config.CursorEffect ~= "Trail" then
            for _, dot in ipairs(trail) do
                dot.Visible = false
            end
            return
        end
        
        local mousePos = UIS:GetMouseLocation()
        
        for i = #trail, 2, -1 do
            trail[i].Position = trail[i - 1].Position
            trail[i].Visible = true
        end
        
        trail[1].Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
        trail[1].Visible = true
        
        for i, dot in ipairs(trail) do
            dot.BackgroundColor3 = Library.Theme.Primary
            dot.BackgroundTransparency = 0.3 + (i / maxTrail) * 0.7
        end
    end)
    
    return conn
end

-- Cursor Particles Effect
function U:CursorParticles(gui)
    local conn = RS.Heartbeat:Connect(function()
        if Library.Config.CursorEffect ~= "Particles" then return end
        
        if math.random(1, 3) == 1 then
            local mousePos = UIS:GetMouseLocation()
            
            local particle = U:New("Frame", {
                BackgroundColor3 = Library.Theme.Primary,
                BackgroundTransparency = 0.4,
                Size = UDim2.new(0, math.random(4, 8), 0, math.random(4, 8)),
                Position = UDim2.new(0, mousePos.X + math.random(-10, 10), 0, mousePos.Y + math.random(-10, 10)),
                AnchorPoint = Vector2.new(0.5, 0.5),
                ZIndex = 1000,
                Parent = gui
            })
            U:Corner(particle, 999)
            
            U:Tween(particle, {
                Position = UDim2.new(0, particle.Position.X.Offset, 0, particle.Position.Y.Offset + math.random(20, 40)),
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 0, 0, 0)
            }, 0.8, Enum.EasingStyle.Quad)
            
            task.delay(0.8, function()
                if particle and particle.Parent then particle:Destroy() end
            end)
        end
    end)
    
    return conn
end

-- Background Effects
function U:BackgroundEffect(parent, effectType)
    if effectType == "Gradient" then
        local gradient = U:New("Frame", {
            BackgroundTransparency = 0.95,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 1,
            Parent = parent
        })
        
        local grad = U:New("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, Library.Theme.Primary),
                ColorSequenceKeypoint.new(0.5, Library.Theme.Secondary),
                ColorSequenceKeypoint.new(1, Library.Theme.Primary)
            }),
            Rotation = 0,
            Parent = gradient
        })
        
        -- Animated gradient
        task.spawn(function()
            while gradient and gradient.Parent do
                for i = 0, 360, 2 do
                    if not gradient or not gradient.Parent then break end
                    grad.Rotation = i
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Library.Theme.Primary),
                        ColorSequenceKeypoint.new(0.5, Library.Theme.Secondary),
                        ColorSequenceKeypoint.new(1, Library.Theme.Primary)
                    })
                    task.wait(0.05)
                end
            end
        end)
        
        return gradient
        
    elseif effectType == "Scanlines" then
        local scanlines = U:New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 999,
            Parent = parent
        })
        
        for i = 0, 50 do
            local line = U:New("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BackgroundTransparency = 0.97,
                Size = UDim2.new(1, 0, 0, 1),
                Position = UDim2.new(0, 0, i / 50, 0),
                BorderSizePixel = 0,
                ZIndex = 999,
                Parent = scanlines
            })
        end
        
        return scanlines
        
    elseif effectType == "Vignette" then
        local vignette = U:New("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 998,
            Parent = parent
        })
        
        local img = U:New("ImageLabel", {
            BackgroundTransparency = 1,
            Image = "rbxassetid://5028857084",
            ImageColor3 = Color3.fromRGB(0, 0, 0),
            ImageTransparency = 0.3,
            ScaleType = Enum.ScaleType.Slice,
            SliceCenter = Rect.new(24, 24, 276, 276),
            Size = UDim2.new(1, 100, 1, 100),
            Position = UDim2.new(0.5, -50, 0.5, -50),
            AnchorPoint = Vector2.new(0.5, 0.5),
            ZIndex = 998,
            Parent = vignette
        })
        
        return vignette
    end
end

